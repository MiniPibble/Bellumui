-- primitives
local function new(class, props, parent)
    local inst = Instance.new(class)
    for key, value in pairs(props or {}) do inst[key] = value end
    if parent then inst.Parent = parent end
    return inst
end
local function corner(o, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = o; return c
end
local function stroke(o, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or Theme.Line; s.Thickness = th or 1; s.Transparency = tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = o
    return s
end
local function tw(o, p, t, style)
    TweenService:Create(o, TweenInfo.new(t or 0.14, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), p):Play()
end
local function label(parent, text, size, color, font, align)
    return new("TextLabel", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Text = text, TextSize = size or 11,
        TextColor3 = color or Theme.Text, Font = font or Enum.Font.GothamMedium,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end

-- click helper that behaves on both mouse and touch
local function bindClick(button, callback)
    local last = 0
    local function fire()
        if tick() - last < 0.16 then return end
        last = tick()
        callback()
    end
    button.Activated:Connect(fire)
    button.MouseButton1Click:Connect(fire)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then fire() end
    end)
end

-- ember gradient fill (frame colour must be white so the gradient shows true)
local function emberFill(inst, rotation)
    inst.BackgroundColor3 = WHITE
    return new("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, GOLD),
            ColorSequenceKeypoint.new(1, EMBER_HOT),
        },
        Rotation = rotation or 0,
    }, inst)
end

-- soft press feedback + optional hover colours
local function pressable(btn, baseProps, hoverProps)
    local scale = new("UIScale", { Scale = 1 }, btn)
    btn.MouseEnter:Connect(function()
        if hoverProps then tw(btn, hoverProps, 0.12) end
    end)
    btn.MouseLeave:Connect(function()
        if baseProps then tw(btn, baseProps, 0.12) end
        tw(scale, { Scale = 1 }, 0.1)
    end)
    btn.MouseButton1Down:Connect(function() tw(scale, { Scale = 0.96 }, 0.08) end)
    btn.MouseButton1Up:Connect(function() tw(scale, { Scale = 1 }, 0.12) end)
end

-- a comet of light that circles a border
local function spinStroke(s, seconds)
    local g = new("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, GOLD),
            ColorSequenceKeypoint.new(0.5, EMBER_HOT),
            ColorSequenceKeypoint.new(1, GOLD),
        },
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.3, 0.88),
            NumberSequenceKeypoint.new(0.7, 0.88),
            NumberSequenceKeypoint.new(1, 0),
        },
        Rotation = 0,
    }, s)
    TweenService:Create(g, TweenInfo.new(seconds or 6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
    return g
end

-- pill switch. Pass onChange=nil to bind the click yourself.
local function makeSwitch(parent, position, initial, onChange)
    local track = new("TextButton", {
        Size = UDim2.fromOffset(46, 26), Position = position,
        BackgroundColor3 = initial and EMBER or Theme.Off,
        BorderSizePixel = 0, AutoButtonColor = false, Active = true, Text = "",
    }, parent)
    corner(track, 99)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(20, 20),
        Position = initial and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10),
        BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, track)
    corner(knob, 99)
    local state = initial
    local function render(value)
        state = value
        tw(track, { BackgroundColor3 = value and EMBER or Theme.Off }, 0.16)
        tw(knob, { Position = value and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10) }, 0.16)
    end
    if onChange then
        bindClick(track, function()
            render(not state)
            onChange(state)
        end)
    end
    return render, track
end

