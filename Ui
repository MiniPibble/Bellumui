    local title = label(card, titleText, 11, Theme.Text, Enum.Font.GothamBold)
    title.Size = UDim2.new(1, -28, 0, 16)
    title.Position = UDim2.fromOffset(14, 12)
    local note = label(card, noteText, 9, Theme.Dim, Enum.Font.GothamMedium)
    note.Size = UDim2.new(1, -28, 0, 14)
    note.Position = UDim2.fromOffset(14, 29)

    local stateLabel = label(card, initial and "ON" or "OFF", 10, initial and EMBER or Theme.Dim,
        Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
    stateLabel.Size = UDim2.fromOffset(40, 26)
    stateLabel.Position = UDim2.new(1, -54, 0, 46)

    local function paint(value)
        tw(cardStroke, { Color = value and EMBER or Theme.Line, Transparency = value and 0.45 or 0.2 }, 0.15)
        stateLabel.Text = value and "ON" or "OFF"
        stateLabel.TextColor3 = value and EMBER or Theme.Dim
    end
    local renderSwitch = makeSwitch(card, UDim2.fromOffset(14, 46), initial, function(state)
        paint(state)
        onChange(state)
    end)
    return function(value) renderSwitch(value); paint(value) end
end

